{
  "schemaVersion": 1,
  "id": "outreach",
  "name": "Outreach mailer",
  "version": "0.1.0",
  "settings": [
    {
      "name": "outreach_url",
      "label": "Outreach URL",
      "secret": false,
      "description": "Where your outreach server runs."
    },
    {
      "name": "outreach_token",
      "label": "Outreach API key",
      "secret": true
    }
  ],
  "contributes": {
    "mcpServers": {
      "outreach": {
        "command": "outreach",
        "args": ["mcp"],
        "settings": {
          "OUTREACH_URL": "outreach_url",
          "OUTREACH_API_KEY_FILE": { "setting": "outreach_token", "file": true }
        }
      }
    }
  }
}
